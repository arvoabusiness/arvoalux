# Arvoa Lux uses the owner-authorized live Shopify catalog.
SHOPIFY_STORE_DOMAIN=arvoalux.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Optional: only set an explicit Storefront token when auth-only fields are required.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Shared secret guarding /api/revalidate (sent by the Shopify webhook).
SHOPIFY_REVALIDATION_SECRET=
