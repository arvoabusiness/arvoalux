# All brand apps point at the SAME Shopify store.
SHOPIFY_STORE_DOMAIN=arvoalux-platform-dev.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-04
# This brand's Headless private Storefront token (server-side only).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Legacy fallback supported for existing deployments.
SHOPIFY_PRIVATE_TOKEN=
# Shared secret guarding /api/revalidate (sent by the Shopify webhook).
SHOPIFY_REVALIDATION_SECRET=
